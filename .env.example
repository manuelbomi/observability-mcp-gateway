# Copy to .env (or export these directly) before running the server/client.
# Never commit a real .env - it's already in .gitignore.

# Shared secret the server checks on every /mcp request (Authorization: Bearer <token>).
# The demo client reads the same value so it can authenticate.
MCP_GATEWAY_TOKEN=change-me-to-a-long-random-string

# HTTP bind address/port for the server.
HOST=127.0.0.1
PORT=8787

# Where the demo client should connect (defaults to the above).
MCP_GATEWAY_URL=http://127.0.0.1:8787/mcp
