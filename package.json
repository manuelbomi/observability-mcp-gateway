{
  "name": "observability-mcp-gateway",
  "version": "0.1.0",
  "description": "A remote (HTTP + SSE) Model Context Protocol server exposing a synthetic observability dataset (logs, metrics, alerts, service health) for a handful of fictional microservices, plus a companion MCP client.",
  "type": "module",
  "main": "dist/server/index.js",
  "author": "Emmanuel Oyekanlu",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "seed": "tsx src/data/generator.ts",
    "client": "tsx src/client/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "better-sqlite3": "^11.3.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^5.0.3"
  }
}
